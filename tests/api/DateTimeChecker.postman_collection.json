  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5080"
    }
  ],
  "item": [
    {
      "name": "Api_Leap2000",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/dates/check",
        "body": {
          "mode": "raw",
          "raw": "{\"day\": 29, \"month\": 2, \"year\": 2000}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON media type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Exact date response\", () => pm.expect(pm.response.json()).to.deep.equal({\"day\": 29, \"month\": 2, \"year\": 2000, \"isValid\": true, \"daysInMonth\": 29, \"message\": \"29/02/2000 is correct date time!\"}));"
            ]
          }
        }
      ]
    },
