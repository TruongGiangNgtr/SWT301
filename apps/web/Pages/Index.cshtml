@page
@model SWT.Pages.IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Date Time Checker</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <main class="date-time-checker">
        <img class="logo" src="/img/logo_fpt.png" alt="FPT University logo" />
        <h1>Date Time Checker</h1>

        <form method="post" class="date-form">
            @Html.AntiForgeryToken()
            <div class="input-row">
                <label for="day">Day</label>
                <input id="day" name="Day" value="@Model.Day" />
            </div>
            <div class="input-row">
                <label for="month">Month</label>
                <input id="month" name="Month" value="@Model.Month" />
            </div>
            <div class="input-row">
                <label for="year">Year</label>
                <input id="year" name="Year" value="@Model.Year" />
            </div>

            <div class="button-row">
                <button type="submit" name="action" value="clear">Clear</button>
                <button type="submit" name="action" value="check">Check</button>
            </div>
        </form>

        @if (Model.DialogMessage is not null)
        {
            <dialog id="message-dialog" open role="dialog" aria-modal="true" aria-describedby="dialog-message">
                <p id="dialog-message">@Model.DialogMessage</p>
                <button type="button" id="dialog-ok">OK</button>
            </dialog>
        }
    </main>

    <script>
        const dialog = document.getElementById("message-dialog");
        const dialogOk = document.getElementById("dialog-ok");
        if (dialog && dialogOk) {
            dialogOk.addEventListener("click", () => dialog.close());
        }
    </script>
</body>
</html>
