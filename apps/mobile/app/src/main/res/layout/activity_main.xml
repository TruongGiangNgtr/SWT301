<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F0F0F0">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="8dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="280dp" android:background="#FFFFFF">
            <FrameLayout android:layout_width="170dp" android:layout_height="64dp" android:layout_marginLeft="20dp" android:layout_marginTop="4dp" android:clipChildren="true">
                <ImageView android:layout_width="170dp" android:layout_height="170dp"
                    android:translationY="-48dp" android:src="@drawable/fpt_logo" android:contentDescription="FPT University logo" />
            </FrameLayout>
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="70dp" android:gravity="center" android:fontFamily="sans-serif"
                android:text="Date Time Checker" android:textSize="32sp" android:textColor="#3399FF" android:includeFontPadding="false" />
            <LinearLayout android:layout_width="200dp" android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="126dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
                    <TextView android:layout_width="46dp" android:layout_height="wrap_content" android:text="Day" android:textSize="11sp" android:textColor="#000000" android:labelFor="@id/day" />
                    <EditText android:id="@+id/day" android:layout_width="100dp" android:layout_height="22dp" android:background="@drawable/date_input" android:paddingHorizontal="3dp" android:paddingVertical="0dp" android:textSize="12sp" android:textColor="#000000" android:inputType="text" android:singleLine="true" android:contentDescription="Day" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
                    <TextView android:layout_width="46dp" android:layout_height="wrap_content" android:text="Month" android:textSize="11sp" android:textColor="#000000" android:labelFor="@id/month" />
                    <EditText android:id="@+id/month" android:layout_width="100dp" android:layout_height="22dp" android:background="@drawable/date_input" android:paddingHorizontal="3dp" android:paddingVertical="0dp" android:textSize="12sp" android:textColor="#000000" android:inputType="text" android:singleLine="true" android:contentDescription="Month" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
                    <TextView android:layout_width="46dp" android:layout_height="wrap_content" android:text="Year" android:textSize="11sp" android:textColor="#000000" android:labelFor="@id/year" />
                    <EditText android:id="@+id/year" android:layout_width="100dp" android:layout_height="22dp" android:background="@drawable/date_input" android:paddingHorizontal="3dp" android:paddingVertical="0dp" android:textSize="12sp" android:textColor="#000000" android:inputType="text" android:singleLine="true" android:contentDescription="Year" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="9dp" android:gravity="center_vertical">
                    <Button android:id="@+id/clear" android:layout_width="73dp" android:layout_height="24dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="Clear" android:textAllCaps="false" android:textSize="11sp" android:textColor="#000000" android:background="@drawable/date_button" android:backgroundTint="@null" />
                    <Button android:id="@+id/check" android:layout_width="73dp" android:layout_height="24dp" android:layout_marginLeft="25dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="Check" android:textAllCaps="false" android:textSize="11sp" android:textColor="#000000" android:background="@drawable/date_button" android:backgroundTint="@null" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#1F293E" android:paddingHorizontal="12dp" android:contentDescription="Result" />
    </LinearLayout>
</ScrollView>
